{
  "name": "video-client-electron",
  "version": "0.1.1",
  "private": true,
  "description": "Electron shell for the Kling-H3 and video shot services",
  "author": {
    "name": "章域·视频混剪智能体"
  },
  "copyright": "Copyright © 2026 章域·视频混剪智能体",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-electron-builder.mjs",
    "start": "electron .",
    "check": "node --check electron/main.mjs && node --check electron/preload.cjs && node --check electron/renderer/app.js",
    "pack:dir": "electron-builder --win --x64 --dir",
    "pack:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.zhangyu.video-mix-agent",
    "productName": "章域·视频混剪智能体",
    "artifactName": "章域·视频混剪智能体-${version}-Setup.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "video-shot-engine-electron-delivery-20260904",
        "to": "services/video-shot",
        "filter": [
          ".env",
          "package.json",
          "src/**/*",
          "public/**/*",
          "LICENSES/**/*"
        ]
      },
      {
        "from": "video-shot-engine-electron-delivery-20260904/node_modules",
        "to": "services/video-shot/node_modules"
      },
      {
        "from": "Kling-H3路线B-Electron交付包-20260904/module",
        "to": "services/product-remake",
        "filter": [
          ".env",
          "package.json",
          "server.mjs",
          "public/**/*"
        ]
      },
      {
        "from": "packaging-resources/tools",
        "to": "tools"
      },
      {
        "from": "packaging-resources/builtin-voices",
        "to": "builtin-voices",
        "filter": [
          "*.wav"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "章域·视频混剪智能体"
    }
  }
}
